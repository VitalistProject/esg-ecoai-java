            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"EcoAl Corp Updated\",\n  \"global_score_goal\": 150\n}",
              "options": {
                "raw": { "language": "json" }
              }
            }
          }
        },
        {
          "name": "Delete Company",
          "request": {
            "method": "DELETE",
            "header": [],
