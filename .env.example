# Copy to .env and fill in the values: cp .env.example .env

# Database (the Postgres container creates the database and user with these same credentials)
DB_URL=jdbc:postgresql://localhost:5432/ecoal
DB_USER=ecoal
DB_PASSWORD=change-me

# JWT signing key (HS256 requires at least 256 bits / 32 characters)
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me
