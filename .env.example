# Copy to .env and fill in the values: cp .env.example .env

# Database (the app user is created by the Oracle container with these same credentials)
DB_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
DB_USER=ecoal
DB_PASSWORD=change-me
# Oracle SYS/SYSTEM password, used only by the db container in docker-compose
ORACLE_PASSWORD=change-me

# JWT signing key (HS256 requires at least 256 bits / 32 characters)
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me
